#!/usr/bin/env node
// story-shot <out.png> <storybook url> <story id> [--dark] [--width N] [--height N] [--html <out.html>] [--inline <out.html>]
// story-shot --list <storybook url> [words]
//
// A picture of one Storybook story, drawn alone as the app draws it: the repo's own components,
// theme and fonts. At 2x, cropped to what the story draws (or the whole viewport, for a story laid
// out fullscreen). --html also writes the story as one self-contained HTML file (its CSS and fonts
// inlined, no scripts), for a canvas that takes HTML. --list prints the stories, id and title, whose
// title or name has every word given.
// --inline writes the story's drawing alone (its [data-testid="story"] element, else what
// #storybook-root holds) with each element's computed styles written on it as style="…" and
// classes dropped: markup to paste into a canvas frame, for a Storybook whose classes are hashed
// (React Native web). Only what differs from the browser's default, and from the parent for what
// inherits, is written; a width or height the content gives is left out. No data: URLs (a canvas
// may refuse them): it lists the images and fonts the copy needs, for the canvas's own uploads.
// --dark copies it dark.
//
// Run from the repo's checkout, installed: Playwright comes from the repo, as record-flow's does.

import { createRequire } from "node:module";
import { existsSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const args = process.argv.slice(2);
const flag = (name) => {
  const i = args.indexOf(name);
  if (i < 0) return undefined;
  const [, value] = args.splice(i, 2);
  return value;
};
const has = (name) => {
  const i = args.indexOf(name);
  if (i < 0) return false;
  args.splice(i, 1);
  return true;
};

function usage() {
  console.error(
    "usage: story-shot <out.png> <storybook url> <story id> [--dark] [--width N] [--height N] [--html out.html] [--inline out.html]\n" +
      "       story-shot --list <storybook url> [words]",
  );
  process.exit(2);
}

async function index(base) {
  const res = await fetch(new URL("index.json", base));
  if (!res.ok) throw new Error(`story-shot: ${base}index.json gave ${res.status}; is Storybook running there?`);
  return Object.values((await res.json()).entries).filter((e) => e.type === "story");
}

const slash = (url) => (url.endsWith("/") ? url : url + "/");

if (has("--list")) {
  const [url, ...words] = args;
  if (!url) usage();
  const want = words.map((w) => w.toLowerCase());
  for (const e of await index(slash(url))) {
    const text = `${e.title} ${e.name}`.toLowerCase();
    if (want.every((w) => text.includes(w))) console.log(`${e.id}\t${e.title} / ${e.name}`);
  }
  process.exit(0);
}

const dark = has("--dark");
const width = Number(flag("--width") ?? 1280);
const height = Number(flag("--height") ?? 800);
const htmlOut = flag("--html");
const inlineOut = flag("--inline");
const [out, url, id] = args;
if (!out || !url || !id) usage();
const base = slash(url);

// Playwright from the repo: its root, or a workspace package that depends on it.
function playwright() {
  const roots = [process.cwd()];
  for (const dir of ["apps", "packages"]) {
    const d = join(process.cwd(), dir);
    if (existsSync(d)) for (const p of readdirSync(d)) roots.push(join(d, p));
  }
  for (const root of roots) {
    const req = createRequire(join(root, "package.json"));
    for (const name of ["playwright", "@playwright/test"]) {
      try {
        return req(name);
      } catch {}
    }
  }
  console.error("story-shot: no Playwright in this repo; run it from the repo's checkout, installed.");
  process.exit(1);
}

const entry = (await index(base)).find((e) => e.id === id);
if (!entry) {
  console.error(`story-shot: no story "${id}". Find its id with: story-shot --list ${url} <words>`);
  process.exit(1);
}

const { chromium } = playwright();
const browser = await chromium.launch();
const page = await browser.newPage({ viewport: { width, height }, deviceScaleFactor: 2, colorScheme: dark ? "dark" : "light" });
const errors = [];
page.on("pageerror", (e) => errors.push(e.message));
const story = new URL("iframe.html", base);
story.searchParams.set("id", id);
story.searchParams.set("viewMode", "story");
story.searchParams.set("globals", `theme:${dark ? "dark" : "light"}`);
await page.goto(story.href, { waitUntil: "networkidle" });
await page.waitForFunction(() => document.querySelector("#storybook-root")?.childElementCount > 0, null, { timeout: 15000 }).catch(() => {});
await page.evaluate(() => document.fonts.ready);
// Animations and transitions to their end, so the picture shows the state, not a frame of getting there.
await page.addStyleTag({ content: "*,*::before,*::after{animation-delay:-1ms!important;animation-duration:1ms!important;animation-iteration-count:1!important;transition-duration:0s!important;transition-delay:0s!important;caret-color:transparent!important}" });
await page.waitForTimeout(400);

const shown = await page.evaluate(() => {
  const root = document.querySelector("#storybook-root");
  const err = document.querySelector(".sb-show-errordisplay #error-message");
  return { empty: !root || root.childElementCount === 0, error: err?.textContent?.trim() || "" };
});
if (shown.error || shown.empty) {
  console.error(`story-shot: the story didn't draw. ${shown.error || errors.join("\n") || "Nothing in #storybook-root."}`);
  await browser.close();
  process.exit(1);
}

// Cropped to what the story draws, unless it's laid out fullscreen (a whole screen).
const layout = entry.parameters?.layout ?? (await page.evaluate(() => (document.body.classList.contains("sb-main-fullscreen") ? "fullscreen" : "")));
const fullscreen = layout === "fullscreen" || (await page.evaluate(() => document.body.classList.contains("sb-main-fullscreen")));
if (fullscreen) {
  await page.screenshot({ path: out });
} else {
  const box = await page.evaluate(() => {
    const els = [...document.querySelectorAll("#storybook-root *")];
    let x1 = Infinity, y1 = Infinity, x2 = -Infinity, y2 = -Infinity;
    for (const el of els) {
      const r = el.getBoundingClientRect();
      if (!r.width || !r.height) continue;
      x1 = Math.min(x1, r.left); y1 = Math.min(y1, r.top); x2 = Math.max(x2, r.right); y2 = Math.max(y2, r.bottom);
    }
    return { x1, y1, x2, y2 };
  });
  const pad = 16;
  const clip = {
    x: Math.max(0, box.x1 - pad),
    y: Math.max(0, box.y1 - pad),
    width: Math.min(width, box.x2 + pad) - Math.max(0, box.x1 - pad),
    height: box.y2 + pad - Math.max(0, box.y1 - pad),
  };
  await page.screenshot({ path: out, clip, fullPage: true });
}

if (htmlOut) {
  // The page as drawn: every stylesheet's rules inlined (fonts as data URLs), scripts dropped.
  const html = await page.evaluate(async (isDark) => {
    const toData = async (u) => {
      const r = await fetch(u);
      const b = await r.blob();
      return await new Promise((ok) => {
        const f = new FileReader();
        f.onload = () => ok(f.result);
        f.readAsDataURL(b);
      });
    };
    // Only the font faces the story loaded: a family's other weights and subsets are megabytes.
    const norm = (v) => String(v || "").replace(/["']/g, "").replace(/\s+/g, "").toLowerCase();
    const key = (family, weight, style, range) => [family, weight || "400", style || "normal", range || "u+0-10ffff"].map(norm).join("|");
    const loaded = new Set([...document.fonts].filter((f) => f.status === "loaded").map((f) => key(f.family, f.weight, f.style, f.unicodeRange)));
    let css = "";
    for (const sheet of document.styleSheets) {
      try {
        for (const rule of sheet.cssRules) {
          let text = rule.cssText;
          if (rule instanceof CSSFontFaceRule) {
            const s = rule.style;
            const k = key(s.getPropertyValue("font-family"), s.getPropertyValue("font-weight"), s.getPropertyValue("font-style"), s.getPropertyValue("unicode-range"));
            if (!loaded.has(k)) continue;
            const m = [...text.matchAll(/url\("?([^")]+)"?\)/g)];
            for (const [, u] of m) {
              const abs = new URL(u, sheet.href || location.href).href;
              text = text.replace(u, await toData(abs));
            }
          }
          css += text + "\n";
        }
      } catch {}
    }
    // Images as data URLs (the ones drawn, at the size drawn), so the file stands alone.
    const root = document.querySelector("#storybook-root").cloneNode(true);
    const live = [...document.querySelectorAll("#storybook-root img")];
    const copies = [...root.querySelectorAll("img")];
    for (let i = 0; i < copies.length; i++) {
      const src = live[i]?.currentSrc || live[i]?.src;
      if (!src || src.startsWith("data:")) continue;
      try {
        copies[i].src = await toData(src);
      } catch {}
      copies[i].removeAttribute("srcset");
      copies[i].removeAttribute("loading");
    }
    // An SVG's <image> (the app's icons draw a light and a dark one, the theme hides one).
    for (const el of root.querySelectorAll("image")) {
      const href = el.getAttribute("href") || el.getAttribute("xlink:href");
      if (!href || href.startsWith("data:")) continue;
      try {
        el.setAttribute("href", await toData(new URL(href, location.href).href));
      } catch {}
    }
    for (const el of root.querySelectorAll("[style*='url(']")) {
      for (const [, u] of el.getAttribute("style").matchAll(/url\(["']?([^"')]+)["']?\)/g)) {
        if (!u.startsWith("data:")) el.setAttribute("style", el.getAttribute("style").replace(u, await toData(new URL(u, location.href).href)));
      }
    }
    const cls = document.documentElement.className;
    return `<!doctype html><html class="${cls}${isDark && !cls.includes("dark") ? " dark" : ""}"><head><meta charset="utf-8"><style>${css}</style></head><body class="${document.body.className}" style="margin:0">${root.outerHTML}</body></html>`;
  }, dark);
  writeFileSync(htmlOut, html);
  console.log(`${htmlOut}: ${(html.length / 1024).toFixed(0)} KB`);
}

if (inlineOut) {
  // The story's own parameters: `screen` marks one drawn as the phone's whole screen.
  const screen = await page.evaluate(() => !!window.__STORYBOOK_PREVIEW__?.currentRender?.story?.parameters?.screen);
  const { html, images, fonts } = await page.evaluate((screen) => {
    const live = document.querySelector('[data-testid="story"]') ?? document.querySelector("#storybook-root > *");
    // The browser's defaults, per tag, from a blank document.
    const frame = document.createElement("iframe");
    document.body.append(frame);
    const blank = frame.contentDocument;
    const defaults = new Map();
    const SVG = "http://www.w3.org/2000/svg";
    const def = (el) => {
      const tag = el.namespaceURI === SVG ? `svg:${el.localName}` : el.localName;
      if (!defaults.has(tag)) {
        const e = el.namespaceURI === SVG ? blank.createElementNS(SVG, el.localName) : blank.createElement(el.localName);
        const host = el.namespaceURI === SVG && el.localName !== "svg" ? blank.createElementNS(SVG, "svg") : blank.body;
        if (host !== blank.body) blank.body.append(host);
        host.append(e);
        const cs = blank.defaultView.getComputedStyle(e), o = {};
        for (const p of cs) o[p] = cs.getPropertyValue(p);
        defaults.set(tag, o);
      }
      return defaults.get(tag);
    };
    const INHERITS = /^(color|font|line-height|letter-spacing|word-spacing|text-(align|transform|indent|shadow|rendering)|white-space|visibility|cursor|direction|list-style|fill|stroke|-webkit-font-smoothing|-webkit-text-fill-color|-moz-osx-font-smoothing|word-break|overflow-wrap|hyphens|quotes|tab-size)/;
    // Logical properties repeat the physical ones (border-inline-start-style is border-left-style
    // here), and one written without its pair draws wrong: only the physical ones are copied.
    const LOGICAL = /^(border|margin|padding|inset|scroll-margin|scroll-padding|overscroll-behavior|contain-intrinsic)-(block|inline)/;
    // A form control takes the browser's font, colour and alignment, not its parent's: everything is written on it.
    const CONTROL = /^(button|input|textarea|select)$/;
    const SKIP = /^(transition|animation|will-change|caret-color|-webkit-tap-highlight|outline|inline-size|block-size|min-inline-size|min-block-size|max-inline-size|max-block-size|perspective-origin|transform-origin)/;
    // A size the content gives (text, a row) is left to the copy's own layout; one the styles set is kept.
    const sizedByContent = (el, prop) => {
      const before = getComputedStyle(el).getPropertyValue(prop);
      const old = el.style.getPropertyValue(prop), oldP = el.style.getPropertyPriority(prop);
      el.style.setProperty(prop, "auto", "important");
      const after = getComputedStyle(el).getPropertyValue(prop);
      el.style.setProperty(prop, old, oldP);
      return before === after;
    };
    // Text is measured again in the copy, so a box with text in it keeps no width its content gave it.
    const holdsText = (el) => [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());
    const copy = live.cloneNode(true);
    const lives = [live, ...live.querySelectorAll("*")], copies = [copy, ...copy.querySelectorAll("*")];
    const images = new Set(), fonts = new Set();
    for (let i = 0; i < lives.length; i++) {
      const el = lives[i], cs = getComputedStyle(el), d = def(el);
      const parent = el === live ? null : getComputedStyle(el.parentElement);
      const out = new Map();
      for (const p of cs) {
        const v = cs.getPropertyValue(p);
        if (p.startsWith("--") || SKIP.test(p) || LOGICAL.test(p) || v === d[p]) continue;
        if (parent && !CONTROL.test(el.localName) && INHERITS.test(p) && parent.getPropertyValue(p) === v) continue;
        if ((p === "width" || p === "height") && holdsText(el) && sizedByContent(el, p)) continue;
        out.set(p, v);
      }
      // Text drawn on one line stays on one line, however the copy measures it.
      if (holdsText(el) && el.namespaceURI !== SVG) {
        const lh = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.3;
        if (el.getBoundingClientRect().height < lh * 1.5) out.set("white-space", "nowrap");
      }
      // A border's style and width go together: a style alone draws at the default width.
      for (const side of ["top", "right", "bottom", "left"]) {
        if (out.has(`border-${side}-style`)) out.set(`border-${side}-width`, cs.getPropertyValue(`border-${side}-width`));
      }
      if (el === live) {
        out.set("font-family", cs.getPropertyValue("font-family"));
        // A whole screen's ground (the phone's background, dark or light) is often an ancestor's.
        for (let a = el; screen && a && !out.has("background-color"); a = a.parentElement) {
          const bg = getComputedStyle(a).backgroundColor;
          if (bg !== "rgba(0, 0, 0, 0)" && bg !== "transparent") out.set("background-color", bg);
        }
      }
      for (const v of [cs.fontFamily]) fonts.add(v.split(",")[0].replace(/["']/g, "").trim());
      const c = copies[i];
      c.removeAttribute("class");
      for (const a of [...c.attributes]) if (a.name.startsWith("data-") && a.name !== "data-testid") c.removeAttribute(a.name);
      const style = [...out].map(([p, v]) => `${p}:${v}`).join(";").replace(/"/g, "'");
      if (style) c.setAttribute("style", style);
      else c.removeAttribute("style");
      if (c.localName === "img") {
        const src = el.currentSrc || el.src;
        if (src) { c.src = src; images.add(src); }
        c.removeAttribute("srcset");
      }
      if (c.localName === "image") {
        const href = c.getAttribute("href") || c.getAttribute("xlink:href");
        if (href) { const abs = new URL(href, location.href).href; c.setAttribute("href", abs); images.add(abs); }
      }
      for (const [, u] of (c.getAttribute("style") || "").matchAll(/url\(["']?([^"')]+)["']?\)/g)) {
        const abs = new URL(u, location.href).href;
        c.setAttribute("style", c.getAttribute("style").replace(u, abs));
        images.add(abs);
      }
    }
    frame.remove();
    // A button inside a button (a row with its menu) is markup HTML can't hold: the outer one becomes a div with the button's role.
    for (const b of [...copy.querySelectorAll("button")].filter((b) => b.querySelector("button"))) {
      const div = document.createElement("div");
      for (const a of b.attributes) div.setAttribute(a.name, a.value);
      div.setAttribute("role", "button");
      div.append(...b.childNodes);
      b.replaceWith(div);
    }
    return { html: copy.outerHTML, images: [...images].filter((u) => !u.startsWith("data:")), fonts: [...fonts] };
  }, screen);
  writeFileSync(inlineOut, html);
  console.log(`${inlineOut}: ${(html.length / 1024).toFixed(0)} KB`);
  if (images.length) console.log(`images it points at (Storybook's, local: upload each and swap its URL):\n  ${images.join("\n  ")}`);
  console.log(`fonts it names (a canvas needs each in its library): ${fonts.join(", ")}`);
}

if (errors.length) console.error(`story-shot: the page logged errors:\n${errors.join("\n")}`);
await browser.close();
console.log(out);
